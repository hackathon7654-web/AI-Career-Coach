# ProofPath AI Backend Configuration Example
# Copy this file to .env and configure local values.
# NEVER commit real credentials or secrets to source control.

# Application Information
APP_NAME="ProofPath AI API"
APP_VERSION="0.1.0"
APP_ENV="development"
DEBUG=false

# Server Configuration
HOST="127.0.0.1"
PORT=8000

# CORS Whitelist (JSON array string or comma-separated list of allowed origins)
FRONTEND_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173"]'

# Candidate Session Security (Phase 3D-1)
SESSION_COOKIE_NAME="proofpath_session"
SESSION_MAX_AGE_SECONDS=604800
# SESSION_COOKIE_SECURE=false # Set to true in production HTTPS environments
SESSION_COOKIE_SAMESITE="lax"
SESSION_COOKIE_PATH="/"

# Supabase Relational Database & RLS (Phase 3C)
# SUPABASE_URL="https://rqmwizqcrtzmynhekagw.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="[server-only-service-role-key]"

# GitHub REST API Integration & Limits (Phase 3D-2)
# GITHUB_TOKEN="ghp_[optional-personal-access-token-for-higher-rate-limits]"
GITHUB_API_BASE_URL="https://api.github.com"
GITHUB_TIMEOUT_SECONDS=10.0
GITHUB_MAX_PAGES=5
GITHUB_PER_PAGE_MAX=50

# Bounded Code Scanner & Safety Budgets (Phase 3D-3)
MAX_FILES_PER_REPO=50
MAX_FILE_SIZE_BYTES=512000
MAX_TOTAL_REPO_BYTES=10485760
SCAN_TIMEOUT_SECONDS=30.0
MAX_SELECTED_REPOSITORIES=10

# GitHub Webhook Ingestion (Phase 3G)
# GITHUB_WEBHOOK_SECRET="[server-side-hmac-sha256-secret]"

# LLM Provider Integration (Phase 3E / 3F)
# LLM_API_KEY="[provider-api-key]"
# LLM_MODEL="gemini-1.5-flash"
